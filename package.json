{
  "name": "stacks",
  "private": true,
  "type": "module",
  "description": "a trello clone",
  "license": "MIT",
  "sideEffects": true,
  "scripts": {
    "build": "vite build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev": "vite dev --force",
    "dev:e2e": "cross-env DATABASE_URL=postgresql://test:test@localhost:5432/test vite dev --config vite.config.e2e.ts --force",
    "format": "pnpm exec biome format . --write",
    "lint:fix": "pnpm exec biome check . --write --unsafe",
    "lint:check": "pnpm exec biome check .",
    "netlify:dev": "netlify dev",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "start": "node .output/server/index.mjs",
    "test": "cross-env playwright test --project=chromium",
    "test:all": "cross-env playwright test",
    "test:chrome": "cross-env playwright test --project=\"Google Chrome\"",
    "test:db:setup": "docker compose up -d --wait && cross-env DATABASE_URL=postgresql://test:test@localhost:5432/test prisma migrate deploy",
    "test:debug": "cross-env playwright test --debug --project=chromium",
    "test:edge": "cross-env playwright test --project=\"Microsoft Edge\"",
    "test:firefox": "cross-env playwright test --project=firefox",
    "test:headed": "cross-env playwright test --headed --ui --project=chromium",
    "test:mobile:chrome": "cross-env playwright test --project=\"Mobile Chrome\"",
    "test:mobile:safari": "cross-env playwright test --project=\"Mobile Safari\"",
    "test:report": "playwright show-report",
    "test:types": "pnpm exec tsc --noEmit",
    "test:ui": "cross-env playwright test --ui",
    "test:webkit": "cross-env playwright test --project=webkit",
    "update:lexical": "sh ./scripts/update-lexical.sh",
    "update:tsr": "sh ./scripts/update-tsr.sh"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.5.11",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/react": "^0.4.0",
    "@lexical/code-core": "^0.50.0",
    "@lexical/extension": "^0.50.0",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/markdown": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/utils": "^0.50.0",
    "@neondatabase/neon-js": "0.6.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/functions": "^0.10.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/tanstackstart-react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.10",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.0",
    "downshift": "^9.4.0",
    "lexical": "^0.50.0",
    "pg": "^8.20.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^4.3.1",
    "styled-components": "7.0.0-prerelease-20260808041113",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@clerk/testing": "^2.0.34",
    "@faker-js/faker": "^10.4.0",
    "@mui/utils": "^6.4.9",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@types/node": "^25.6.2",
    "@types/node-uuid": "^0.0.29",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.27",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "netlify-cli": "^17.38.1",
    "prisma": "^7.8.0",
    "react-is": "18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm lint:check",
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "overrides": {
      "react-is": "18.3.1"
    },
    "onlyBuiltDependencies": [
      "@clerk/shared"
    ]
  }
}
